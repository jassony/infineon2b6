        <register>
          <name>INT_MASK</name>
          <description>Interrupt Mask Control</description>
          <addressOffset>0x12</addressOffset>
          <size>16</size>
          <resetValue>0x140</resetValue>
          <resetMask>0xFF00</resetMask>
          <fields>
            <field>
              <name>INTN_CYC_EN</name>
              <description>Periodical INTN generation</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, no periodical INTN event generated in case of pending interrupts</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ENABLED, periodical INTN event generated in case of pending interrupts</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WD_SDM_DISABLE</name>
              <description>Disable Watchdog in Software Development Mode</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> ENABLED, WD is enabled in Software Development Mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> DISABLED, WD is disabled in Software Development Mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WD_SDM</name>
              <description>Watchdog failure in Software Development Mode</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, no INTN event generated in case of WD trigger failure in Software Development Mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ENABLED, one INTN event is generated in case of WD trigger failure in Software Development Mode</description>
                  <value>1</value>
                </enumeratedValue>
