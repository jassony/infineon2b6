                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> DISABLED, shudown disabled in case of VS Overvoltage</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS2_OV_SDN_DIS</name>
              <description>Shutdown Disabling of HS2 in case of input supply overvoltage in Normal Mode</description>
