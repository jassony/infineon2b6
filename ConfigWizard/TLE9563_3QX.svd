                <enumeratedValue>
                  <name>value2</name>
                  <description> DIASBLED, shudown disabled in case of VS Overvoltage</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS1_OV_SDN_DIS</name>
              <description>Shutdown Disabling of HS1 in case of input supply overvoltage in Normal Mode</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> ENABLED, shudown enabled in case of VS Overvoltage</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> DISABLED, shudown disabled in case of VS Overvoltage</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS_OV_SDS_DIS</name>
              <description>Shutdown Disabling of HSx in case of input supply overvoltage in Stop Mode or Sleep Mode</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
