                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ENABLED, one INTN event generated in case BD_STAT (on Status Information Field) is set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS_STAT</name>
              <description>High Side Interrupt generation</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, no INTN event generated in case HS_STAT (on Status Information Field) is set</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ENABLED, one INTN event generated in case HS_STAT (on Status Information Field) is set</description>
                  <value>1</value>
