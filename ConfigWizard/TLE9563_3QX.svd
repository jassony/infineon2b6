                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description>20ms, 20ms</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value3</name>
                  <description>50ms, 50ms</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
