            </field>
            <field>
              <name>SPI_CRC_FAIL</name>
              <description>SPI and CRC interrupt generation</description>
              <lsb>5</lsb>
              <msb>5</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, no INTN event generated in case of SPI_FAIL or CRC_FAIL</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ENABLED, one INTN event is generated n case of SPI_FAIL or CRC_FAIL</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BD_STAT</name>
