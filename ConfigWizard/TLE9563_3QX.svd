          <addressOffset>0x5c</addressOffset>
          <size>16</size>
          <resetValue>0x00</resetValue>
          <resetMask>0xF1</resetMask>
          <fields>
            <field>
              <name>OSC_CAL</name>
              <description>Oscillator Calibration Mode</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, Oscillator Calibration is disabled</description>
