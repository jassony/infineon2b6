        <register>
          <name>SWK_STAT</name>
          <description>Selective Wake Status</description>
          <addressOffset>0x9c</addressOffset>
          <size>16</size>
          <resetValue>0x00</resetValue>
          <resetMask>0x7C</resetMask>
          <fields>
            <field>
              <name>SYNC</name>
              <description>Synchronisation (at least one CAN frame without fail must have been received)</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
