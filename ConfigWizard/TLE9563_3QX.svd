        <register>
          <name>SW_SD_CTRL</name>
          <description>High-Side Switch Shutdown Control</description>
          <addressOffset>0x0e</addressOffset>
          <size>16</size>
          <resetValue>0x00</resetValue>
          <resetMask>0xFB7A</resetMask>
          <fields>
            <field>
              <name>HS3_OV_REC</name>
              <description>Switch recovery after removal of VS Overvoltage for HS3</description>
              <lsb>14</lsb>
              <msb>14</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, Switch recovery is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> PREVIOUS, Previous state before VS Overvoltage is enabled after Overvoltage considtion is removed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS2_OV_REC</name>
              <description>Switch recovery after removal of VS Overvoltage for HS2</description>
              <lsb>13</lsb>
              <msb>13</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, Switch recovery is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> PREVIOUS, Previous state before VS Overvoltage is enabled after Overvoltage considtion is removed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS1_OV_REC</name>
              <description>Switch recovery after removal of VS Overvoltage for HS1</description>
              <lsb>12</lsb>
              <msb>12</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> DISABLED, Switch recovery is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> PREVIOUS, Previous state before VS Overvoltage is enabled after Overvoltage considtion is removed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS_OT_SD_DIS</name>
              <description>Shutdown Disabling of all HS in case of Overtemperature event</description>
              <lsb>11</lsb>
              <msb>11</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> ALL, shudown for all HSx in case of Overtemperature</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> INDIVIDUAL, individual shudown in case of Overtemperature</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HS3_OV_SDN_DIS</name>
