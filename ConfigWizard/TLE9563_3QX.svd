                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> SYNC, Valid CAN frame received, SWK function is synchronous to CAN bus</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUP</name>
              <description>Wake-up Pattern Detection</description>
              <lsb>5</lsb>
              <msb>5</msb>
              <access>read-clear</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> NO_WUP, No WUP</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> WUP_DETECTED, WUP detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUF</name>
              <description>SWK Wake-up Frame Detection</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <access>read-clear</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> NO_WUF, No WUF</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> WUF_DETECTED, WUF detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CANSIL</name>
              <description>CAN Silent Time during SWK operation</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> NO_SIL, tsilence not exceeded</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> SIL_EXCEEDED, set if tsilence is exceeded.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWK_SET</name>
              <description>Selective Wake Activity</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>value1</name>
                  <description> INACTIVE, Selective Wake is not active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>value2</name>
                  <description> ACTIVE, Selective Wake is activated</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SWK_ECNT_STAT</name>
          <description>Selective Wake ECNT Status</description>
          <addressOffset>0x9e</addressOffset>
          <size>16</size>
          <resetValue>0x00</resetValue>
          <resetMask>0x3F</resetMask>
          <fields>
            <field>
              <name>ECNT</name>
              <description>SWK CAN Frame Error Counter</description>
              <lsb>0</lsb>
              <msb>5</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SWK_CDR_STAT</name>
          <description>Selective Wake CDR Status</description>
          <addressOffset>0xa0</addressOffset>
          <size>16</size>
          <resetValue>0xA000</resetValue>
          <resetMask>0xFFFE</resetMask>
          <fields>
            <field>
              <name>N_AVG</name>
              <description>Output Value from Filter Block</description>
              <lsb>4</lsb>
              <msb>15</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FAM_PROD_STAT</name>
          <description>Family and Product Identification Register</description>
          <addressOffset>0xa2</addressOffset>
          <size>16</size>
          <resetValue>0x402</resetValue>
          <resetMask>0xFF06</resetMask>
          <fields>
            <field>
              <name>FAM</name>
              <description>Device Family Identifier</description>
              <lsb>7</lsb>
              <msb>10</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>PROD</name>
              <description>Device Product Identifier</description>
              <lsb>0</lsb>
              <msb>6</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
