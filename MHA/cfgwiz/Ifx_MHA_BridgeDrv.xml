                    <item label="20" value="1" lockon="TLE9563.CSA.CSAG=1"/>
                    <item label="40" value="2" lockon="TLE9563.CSA.CSAG=2"/>
                    <item label="60" value="3" lockon="TLE9563.CSA.CSAG=3"/>
                </combo>
                
                <spinbox label="Execution Period" suffix=" us" define="IFX_MHA_BRIDGEDRV_CFG.EXECUTION_PERIOD_US" header="Ifx_MHA_BridgeDrv_Cfg.h" svd="0" default="500"/>
                
            </checkbox>
